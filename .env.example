# В production по умолчанию https://sona-ai.watch. Для локальной разработки оставьте пустым.
SONA_SITE_ORIGIN=
# Публичные реквизиты, отображаются на /privacy, /terms и /help.
SONA_OPERATOR_NAME=
SONA_SUPPORT_EMAIL=
# Собственный Traefik — email администратора для регистрации Let's Encrypt.
ACME_EMAIL=
# Общий Traefik — имена существующей сети Docker и резолвера.
TRAEFIK_NETWORK=
TRAEFIK_CERT_RESOLVER=
# Необязательный стабильный UUID гостевой установки публичного каталога для этой среды.
SONA_CATALOG_DEVICE_ID=
SONA_API_ORIGIN=https://sona.indicart.org

# Публичный ключ проверки при регистрации
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# JSON-объект: SKU из /v1/products → UUID продукта Stripe Checkout из админ-панели Sona.
SONA_WEB_PRODUCT_IDS={}

# Firebase web app config and public Web Push VAPID key
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
